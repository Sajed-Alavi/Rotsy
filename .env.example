# =============================================================================
# Rotsy — management and image-scanning console for Sonatype Nexus
# -----------------------------------------------------------------------------
# Copy to ".env" and fill in real values. NEVER commit the real .env.
# All values are REQUIRED (no defaults in code → fail-fast if missing).
# =============================================================================

# --- Nexus connection (OPTIONAL after first launch) --------------------------
# Bootstrap defaults so the wrapper can reach Nexus before you log in. Once an
# admin saves Nexus settings via the dashboard (Settings → Nexus Connection),
# the database value takes precedence and these are ignored. You can leave
# them blank to force first-run setup from the UI.
# Use host.docker.internal (not localhost) when Nexus runs on the Docker host.
# Left blank on purpose: no example URL/credentials, so a fresh deployment
# shows an empty Settings → Nexus connection form instead of a value that
# looks configured until someone actually checks it.
NEXUS_URL=
NEXUS_USERNAME=
NEXUS_PASSWORD=
NEXUS_VERIFY_SSL=true

# --- GitHub App (OPTIONAL — configure via Settings -> Integrations -> GitHub)
# Bootstrap defaults only; once saved via the dashboard, the database value
# takes precedence. Create the App at github.com/settings/apps — needs
# Contents:Read, Commit statuses:Write, and a webhook pointed at
# {your-rotsy-url}/api/modules/github/webhooks.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- SonarQube (OPTIONAL — configure via Settings -> Integrations -> SonarQube)
# Bootstrap defaults only; once saved via the dashboard, the encrypted database
# value takes precedence. For local dev, docker-compose-nexus/ in the repo
# root runs a throwaway SonarQube at http://localhost:9000 (admin/admin on
# first login) alongside the dev Nexus instance.
SONAR_URL=
SONAR_ADMIN_TOKEN=

# --- Database (v2 persistence) ----------------------------------------------
DATABASE_URL=postgresql+asyncpg://nexus:REPLACE_WITH_A_STRONG_PASSWORD@postgres:5432/nexus

# --- Auth (JWT in httpOnly cookies) -----------------------------------------
# Generate with:  openssl rand -hex 32
# The backend refuses to start if this is left as a placeholder or is under
# 32 characters (see Settings._reject_placeholder_jwt_secret in config.py).
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
# REQUIRED — encrypts the dashboard-stored Nexus password at rest.
# Generate with:  openssl rand -hex 32
#
# This must be a DIFFERENT value from JWT_SECRET, and the backend refuses to
# start if it is missing, a placeholder, under 32 characters, or equal to
# JWT_SECRET. The two protect different things (token signing vs. data at rest)
# and must be rotatable independently — sharing them meant that leaking
# JWT_SECRET also decrypted stored Nexus admin credentials from a DB backup.
#
# UPGRADING an existing deployment: any Nexus password already saved via the
# dashboard was encrypted with the old JWT_SECRET-derived key and will not
# decrypt under this one. After setting this, open Settings in the dashboard
# and re-enter the Nexus password once. Nothing else is affected.
NEXUS_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=1800
# Sets the Secure flag on auth cookies. Ships as true — the safe default.
# Browsers treat http://localhost as a secure context, so true works for local
# development too; only set it to false if you reach the frontend over plain
# HTTP on a non-localhost host (e.g. http://192.168.1.10:8080), and expect a
# startup warning when you do. The backend refuses to start with
# COOKIE_SECURE=false and an https:// FRONTEND_ORIGIN, since that pairing ships
# auth cookies without Secure to a TLS site.
COOKIE_SECURE=true
FRONTEND_ORIGIN=http://localhost:8080
# Optional. Base URL GitHub/GitLab servers use to reach *this* backend for
# webhook delivery — leave unset to reuse FRONTEND_ORIGIN (correct once this
# is deployed somewhere genuinely public, since a human's browser and GitHub/
# GitLab's servers then reach the same address). Only needed when the two
# addresses differ, the common case being a self-hosted GitLab container on
# the same Docker host as this backend: GitLab can reach this backend at
# http://host.docker.internal:${BACKEND_PORT}, but GitLab's own SSRF
# protection rejects a webhook URL pointing at FRONTEND_ORIGIN's
# http://localhost — that's a *human's browser* address, not GitLab's.
# WEBHOOK_BASE_URL=http://host.docker.internal:8000

# --- Bootstrap admin (created on first startup) -----------------------------
# The backend refuses to start if this is left as a placeholder or is under
# 12 characters (see Settings._reject_placeholder_admin_password in config.py).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Cache (Redis) ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# --- Deep Storage Analyzer tuning -------------------------------------------
ANALYZER_MAX_CONCURRENCY=15
ANALYZER_REQUEST_TIMEOUT=15

# --- Monitoring (v3) --------------------------------------------------------
METRIC_COLLECTION_INTERVAL_SECONDS=300
METRIC_RETENTION_DAYS=90

# --- Retention scheduler (v4) -----------------------------------------------
RETENTION_RUN_AT=02:30

# --- Scanner (v4: Trivy/Grype) ----------------------------------------------
SCANNER_DB_UPDATE_INTERVAL_HOURS=24
# Optional fixed time-of-day for the DB refresh (HH:MM, 24h, server-local),
# e.g. "03:00". When set, the refresh runs once daily at this time instead of
# every SCANNER_DB_UPDATE_INTERVAL_HOURS. Leave empty to use the interval.
SCANNER_DB_UPDATE_AT=
# Air-gapped/restricted network: when true, the scheduled refresh IMPORTS
# pre-downloaded archives from the offline dir (no network) instead of
# downloading. Drop archives into ./offline-db (mounted at /app/offline-db).
# The on-demand "Import offline DBs" action always works regardless.
SCANNER_DB_OFFLINE_MODE=false
# Host dir (mounted into the backend at /app/offline-db) holding pre-downloaded
# DB archives: db.tar.gz [+ javadb.tar.gz] for Trivy, grype-db.tar.gz for Grype.
SCANNER_OFFLINE_DIR=/app/offline-db
SCANNERS_ENABLED=trivy,grype
# How many scan_image jobs run their scanners concurrently — the rest queue.
# Also sizes Trivy's private cache-dir replica pool (disk cost: this many x
# the on-disk Trivy DB size, ~1.2GB each). Raise for higher scan throughput
# when many images are queued at once, at the cost of CPU/IO and disk.
SCANNER_MAX_CONCURRENCY=4
# Optional HTTP/HTTPS proxy for scanner DB downloads (Trivy DBs come from
# GitHub/OCI registries which may be slow/blocked without a proxy). Leave
# empty for direct. Example: http://127.0.0.1:2080
SCANNER_PROXY=

# Grype's own download deadlines, passed through to `grype db update`.
#
# Grype's defaults are 5m for the database and 30s for the metadata, which
# assume a fast link. The v6 database is ~139 MB, so a connection doing
# 150 KB/s needs roughly fifteen minutes — the default expires mid-transfer and
# Grype reports `unable to download db: unexpected EOF`. That message reads like
# a network fault rather than a deadline, which is exactly the wrong place to
# start looking. Raised here so a slow link succeeds instead.
#
# Lower them if your link is fast and you would rather fail quickly than hang.
GRYPE_DB_UPDATE_DOWNLOAD_TIMEOUT=45m
GRYPE_DB_UPDATE_AVAILABLE_TIMEOUT=2m

# --- Outbound request guard (SSRF) ------------------------------------------
# Alert webhooks and Nexus-to-Nexus sync targets are URLs a user supplies and
# the *backend* then calls from inside your network. By default any destination
# resolving to a loopback, private (RFC1918), link-local or otherwise reserved
# address is rejected — that block covers the cloud metadata endpoint
# (169.254.169.254).
#
# On-prem deployments that legitimately post to an internal host list it here.
# Comma-separated hostnames or bare IPs, matched against the URL host:
#   OUTBOUND_ALLOWED_HOSTS=alerts.internal,10.0.0.5
# Empty (the default) means no private destinations are allowed at all.
OUTBOUND_ALLOWED_HOSTS=

# --- Backup archive (byte-level full/selective backup) ----------------------
# Dir the backend writes archive runs to — mounted to the dedicated
# `backup-data` volume in docker-compose.yml.
BACKUP_OUTPUT_DIR=/app/backups
# Abort a run rather than fill the volume to zero if free space drops below
# this many bytes.
BACKUP_MIN_FREE_BYTES=536870912
# How often (seconds) the scheduled-backup loop polls for due BackupSchedule
# rows. Independent schedules can each have their own cadence (including
# custom cron expressions), so this polls rather than sleeping until one
# shared time.
BACKUP_SCHEDULER_POLL_SECONDS=60

# How often retention policies with their own interval_minutes (rather than
# the shared daily RETENTION_RUN_AT sweep) are checked for being due.
RETENTION_SCHEDULER_POLL_SECONDS=60

# --- Scan triggers ----------------------------------------------------------
# Scans are event-driven: an image is scanned when it is PUSHED, or when you
# click Scan. Nothing here can make the system sweep existing images.
#
# NOTE: there is no Docker registry URL/port setting. Each Docker repository's
# connector endpoint is discovered from Nexus at scan time, so adding
# repositories or moving a connector port needs no change here.
#
# Shared secret for the Nexus push webhook. Leave empty and the backend
# generates one on first use; read it from Settings → Scan-on-push webhook (or
# GET /api/scan/webhook) and paste it into the Nexus webhook capability.
NEXUS_WEBHOOK_SECRET=
# Fallback for deployments without webhooks: how often (seconds) to check
# enabled repositories for images the ledger has never seen. Metadata only —
# never re-scans anything already known. 0 disables it (webhooks only).
SCAN_PUSH_POLL_SECONDS=60

# --- Backend server runtime -------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Postgres container credentials -----------------------------------------
# Must match the password in DATABASE_URL above — not independently validated
# by the backend, since Postgres itself reads this directly.
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=/api
BACKEND_UPSTREAM=backend:8000
FRONTEND_PORT=8080

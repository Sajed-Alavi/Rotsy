# -----------------------------------------------------------------------------
# Secrets — NEVER commit real environment files.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------------------------------------
# Python / backend
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.log

# -----------------------------------------------------------------------------
# Node / frontend
# -----------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Editor / OS
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
docker-compose.override.yml

# Local Nexus + SonarQube instances used for development: their compose file,
# blob store, database and logs. Runtime data, not source — every container
# start rewrites hundreds of files under nexus-data/ and sonarqube-data/.
docker-compose-nexus/

# Standalone local SonarQube used to develop/verify the Sonar module against
# something other than a bundled instance. Same reasoning as
# docker-compose-nexus/ — Elasticsearch indices, Postgres data and logs are
# runtime state, not source, and are gigabytes of churn per run.
docker-compose-sonar/

# Local GitLab instance used for development (self-hosted GitLab, for testing
# the future GitLab module against something other than gitlab.com). Same
# reasoning as docker-compose-nexus/ — config/logs/data are runtime state.
docker-compose-gitlab/

# Offline scanner DB archives (large binaries, not source). The directory
# itself is tracked so the docker-compose bind mount always has a target.
offline-db/*
!offline-db/.gitkeep

# Exclude everything not needed for the backend image.
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# tests/ is NOT excluded: the `test` build stage (backend/Dockerfile) needs
# it in the build context to COPY it in. The `base`/production stage never
# copies it, so it still never ends up in the image that actually runs.
*.md
Dockerfile
.dockerignore

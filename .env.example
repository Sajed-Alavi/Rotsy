# =============================================================================
# Nexus Repository Manager — Advanced Web Wrapper (v2)
# -----------------------------------------------------------------------------
# Copy to ".env" and fill in real values. NEVER commit the real .env.
# All values are REQUIRED (no defaults in code → fail-fast if missing).
# =============================================================================

# --- Nexus connection (OPTIONAL after first launch) --------------------------
# Bootstrap defaults so the wrapper can reach Nexus before you log in. Once an
# admin saves Nexus settings via the dashboard (Settings → Nexus Connection),
# the database value takes precedence and these are ignored. You can leave
# them blank to force first-run setup from the UI.
# Use host.docker.internal (not localhost) when Nexus runs on the Docker host.
NEXUS_URL=http://host.docker.internal:8081
NEXUS_USERNAME=admin
NEXUS_PASSWORD=change-me
NEXUS_VERIFY_SSL=true

# --- Database (v2 persistence) ----------------------------------------------
DATABASE_URL=postgresql+asyncpg://nexus:change-me@postgres:5432/nexus

# --- Auth (JWT in httpOnly cookies) -----------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=generate-a-32-byte-hex-secret
# Optional: separate key for encrypting the dashboard-stored Nexus password.
# If unset, one is derived from JWT_SECRET. Set explicitly in production.
NEXUS_CONFIG_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=1800
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:8080

# --- Bootstrap admin (created on first startup) -----------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Cache (Redis) ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# --- Deep Storage Analyzer tuning -------------------------------------------
ANALYZER_MAX_CONCURRENCY=15
ANALYZER_REQUEST_TIMEOUT=15

# --- Monitoring (v3) --------------------------------------------------------
METRIC_COLLECTION_INTERVAL_SECONDS=300
METRIC_RETENTION_DAYS=90

# --- Retention scheduler (v4) -----------------------------------------------
RETENTION_RUN_AT=02:30

# --- Scanner (v4: Trivy/Grype) ----------------------------------------------
SCANNER_DB_UPDATE_INTERVAL_HOURS=24
# Optional fixed time-of-day for the DB refresh (HH:MM, 24h, server-local),
# e.g. "03:00". When set, the refresh runs once daily at this time instead of
# every SCANNER_DB_UPDATE_INTERVAL_HOURS. Leave empty to use the interval.
SCANNER_DB_UPDATE_AT=
# Air-gapped/restricted network: when true, the scheduled refresh IMPORTS
# pre-downloaded archives from the offline dir (no network) instead of
# downloading. Drop archives into ./offline-db (mounted at /app/offline-db).
# The on-demand "Import offline DBs" action always works regardless.
SCANNER_DB_OFFLINE_MODE=false
# Host dir (mounted into the backend at /app/offline-db) holding pre-downloaded
# DB archives: db.tar.gz [+ javadb.tar.gz] for Trivy, grype-db.tar.gz for Grype.
SCANNER_OFFLINE_DIR=/app/offline-db
SCANNERS_ENABLED=trivy,grype
# Optional HTTP/HTTPS proxy for scanner DB downloads (Trivy DBs come from
# GitHub/OCI registries which may be slow/blocked without a proxy). Leave
# empty for direct. Example: http://127.0.0.1:2080
SCANNER_PROXY=

# --- Backend server runtime -------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Postgres container credentials -----------------------------------------
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=/api
BACKEND_UPSTREAM=backend:8000
FRONTEND_PORT=8080
